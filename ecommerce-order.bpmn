<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_Ecommerce"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">
  <bpmn:collaboration id="Collaboration_Ecommerce">
    <bpmn:participant id="Participant_Ecommerce" name="Toko E-Commerce"
                      processRef="Process_EcommerceOrder" />
  </bpmn:collaboration>

  <bpmn:process id="Process_EcommerceOrder" name="E-Commerce Order Fulfillment"
                isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:documentation>
      Proses fulfillment pesanan e-commerce: reservasi stok (web service),
      keputusan manajer (user task) dengan timer pengingat, pembayaran,
      pembuatan invoice dan pengemasan secara paralel. Pengemasan fisik
      (manual task) diikuti konfirmasi gudang (user task), inspeksi fisik
      (manual task), dan pencatatan hasil QC (user task). Hasil gagal kembali
      ke pengemasan sampai lolos. Booking pengiriman menunggu invoice dan
      hasil QC yang lolos. Pembayaran dan invoice tidak diulang saat rework.
      Stok habis atau penolakan manajer mengakhiri pesanan melalui pelepasan stok.
    </bpmn:documentation>

    <bpmn:laneSet id="LaneSet_Ecommerce">
      <bpmn:lane id="Lane_System" name="Sistem">
        <bpmn:flowNodeRef>StartEvent_OrderPlaced</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_ReserveStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StockAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_ChargePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PrepareOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CreateInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OrderReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_ShipOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_CancelOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ServiceTask_SendReminder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Completed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Cancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_ReminderSent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Manajer Pesanan">
        <bpmn:flowNodeRef>UserTask_ManagerApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryEvent_ApprovalTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OrderApproved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Warehouse" name="Staf Gudang">
        <bpmn:flowNodeRef>ManualTask_WarehousePacking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_WarehouseConfirmation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QualityControl" name="Petugas QC">
        <bpmn:flowNodeRef>ManualTask_InspectPackaging</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_QualityInspection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_QualityPassed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_OrderPlaced" name="Pesanan diterima">
      <bpmn:outgoing>Flow_Start_Reserve</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="ServiceTask_ReserveStock" name="Reservasi stok">
      <bpmn:documentation>Web service task: memanggil inventory service untuk mereservasi stok.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://mock-api:8081/inventory/reserve</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">{"orderId":"${orderId}","sku":"${sku}","qty":${qty}}</camunda:inputParameter>
            <camunda:outputParameter name="reserveResponse">${response}</camunda:outputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_Reserve</bpmn:incoming>
      <bpmn:outgoing>Flow_Reserve_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_StockAvailable" name="Stok tersedia?" default="Flow_OutOfStock_Cancel">
      <bpmn:incoming>Flow_Reserve_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_InStock_Approval</bpmn:outgoing>
      <bpmn:outgoing>Flow_OutOfStock_Cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="UserTask_ManagerApproval" name="Persetujuan manajer"
                   camunda:assignee="${execution.hasVariable('managerUser') ? managerUser : 'demo'}">
      <bpmn:documentation>User Task: centang Setujui pesanan untuk menyetujui; biarkan tidak dicentang untuk menolak, lalu klik Complete. Jika 20 detik tidak direspons, timer mengirim pengingat tanpa membatalkan task.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="approved" label="Setujui pesanan? (tidak dicentang = ditolak)" type="boolean" defaultValue="false" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_InStock_Approval</bpmn:incoming>
      <bpmn:outgoing>Flow_Approval_Decision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="BoundaryEvent_ApprovalTimeout" name="Pengingat 20 detik"
                        attachedToRef="UserTask_ManagerApproval" cancelActivity="false">
      <bpmn:outgoing>Flow_Timeout_Reminder</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_ApprovalTimeout">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT20S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="ServiceTask_SendReminder" name="Kirim pengingat approval">
      <bpmn:documentation>Web service task: mengirim notifikasi pengingat ke manajer.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://mock-api:8081/notification/reminder</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">{"orderId":"${orderId}","message":"Menunggu persetujuan manajer"}</camunda:inputParameter>
            <camunda:outputParameter name="reminderResponse">${response}</camunda:outputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Timeout_Reminder</bpmn:incoming>
      <bpmn:outgoing>Flow_Reminder_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_OrderApproved" name="Pesanan disetujui?" default="Flow_Approval_Rejected">
      <bpmn:incoming>Flow_Approval_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_Approval_Charge</bpmn:outgoing>
      <bpmn:outgoing>Flow_Approval_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ServiceTask_ChargePayment" name="Proses pembayaran">
      <bpmn:documentation>Web service task: menagih pembayaran ke payment gateway.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://mock-api:8081/payment/charge</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">{"orderId":"${orderId}","amount":${amount}}</camunda:inputParameter>
            <camunda:outputParameter name="paymentResponse">${response}</camunda:outputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approval_Charge</bpmn:incoming>
      <bpmn:outgoing>Flow_Charge_Prepare</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="Gateway_PrepareOrder">
      <bpmn:incoming>Flow_Charge_Prepare</bpmn:incoming>
      <bpmn:outgoing>Flow_Prepare_Invoice</bpmn:outgoing>
      <bpmn:outgoing>Flow_Prepare_Packing</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="ServiceTask_CreateInvoice" name="Buat invoice">
      <bpmn:documentation>Service Task: membuat invoice melalui API, paralel dengan pekerjaan gudang. Respons disimpan sebagai invoiceResponse.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://mock-api:8081/invoice/create</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">{"orderId":"${orderId}","amount":${amount}}</camunda:inputParameter>
            <camunda:outputParameter name="invoiceResponse">${response}</camunda:outputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Prepare_Invoice</bpmn:incoming>
      <bpmn:outgoing>Flow_Invoice_Ready</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:manualTask id="ManualTask_WarehousePacking" name="Kemas / kemas ulang barang">
      <bpmn:documentation>Manual Task: staf gudang mengemas barang secara fisik, atau memperbaiki kemasan setelah inspeksi gagal. Camunda melewati simbol ini tanpa menunggu. User task berikutnya menunggu konfirmasi bahwa pekerjaan fisik selesai.</bpmn:documentation>
      <bpmn:incoming>Flow_Prepare_Packing</bpmn:incoming>
      <bpmn:incoming>Flow_Quality_Rework</bpmn:incoming>
      <bpmn:outgoing>Flow_Packing_Confirmation</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:userTask id="UserTask_WarehouseConfirmation" name="Konfirmasi pengemasan selesai"
                   camunda:assignee="${execution.hasVariable('warehouseUser') ? warehouseUser : 'demo'}">
      <bpmn:documentation>User Task: kemas atau perbaiki kemasan secara fisik terlebih dahulu. Klik Complete hanya setelah pekerjaan selesai dan siap diinspeksi QC. Task konfirmasi baru dibuat pada setiap putaran rework.</bpmn:documentation>
      <bpmn:incoming>Flow_Packing_Confirmation</bpmn:incoming>
      <bpmn:outgoing>Flow_Confirmation_Inspect</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:manualTask id="ManualTask_InspectPackaging" name="Periksa fisik kemasan">
      <bpmn:documentation>Manual Task: petugas QC memeriksa kualitas kemasan dan kesiapan kirim di luar aplikasi. Camunda tidak melacak pekerjaan fisik; user task berikutnya menunggu hasil pemeriksaan.</bpmn:documentation>
      <bpmn:incoming>Flow_Confirmation_Inspect</bpmn:incoming>
      <bpmn:outgoing>Flow_Inspect_Record</bpmn:outgoing>
    </bpmn:manualTask>

    <bpmn:userTask id="UserTask_QualityInspection" name="Catat hasil inspeksi"
                   camunda:assignee="${execution.hasVariable('inspectorUser') ? inspectorUser : 'demo'}">
      <bpmn:documentation>User Task: lakukan pemeriksaan fisik terlebih dahulu. Centang Inspeksi lulus jika kemasan layak dikirim; tidak dicentang berarti perlu perbaikan. Klik Complete untuk mengirim hasil. Nilai direset setiap inspeksi baru; hasil gagal mengembalikan pekerjaan ke gudang.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener event="start" expression="${execution.setVariable('qualityPassed', false)}" />
        <camunda:formData>
          <camunda:formField id="qualityPassed" label="Inspeksi lulus? (tidak dicentang = perlu perbaikan)" type="boolean" defaultValue="false" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Inspect_Record</bpmn:incoming>
      <bpmn:outgoing>Flow_Inspection_Decision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_QualityPassed" name="Lolos inspeksi?" default="Flow_Quality_Rework">
      <bpmn:incoming>Flow_Inspection_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_Quality_Ready</bpmn:outgoing>
      <bpmn:outgoing>Flow_Quality_Rework</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:parallelGateway id="Gateway_OrderReady">
      <bpmn:incoming>Flow_Invoice_Ready</bpmn:incoming>
      <bpmn:incoming>Flow_Quality_Ready</bpmn:incoming>
      <bpmn:outgoing>Flow_Ready_Ship</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:serviceTask id="ServiceTask_ShipOrder" name="Buat booking pengiriman">
      <bpmn:documentation>Web service task: membuat booking pengiriman di logistik.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://mock-api:8081/shipment/book</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">{"orderId":"${orderId}","sku":"${sku}","qty":${qty}}</camunda:inputParameter>
            <camunda:outputParameter name="shipmentResponse">${response}</camunda:outputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Ready_Ship</bpmn:incoming>
      <bpmn:outgoing>Flow_Ship_Completed</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ServiceTask_CancelOrder" name="Batalkan pesanan">
      <bpmn:documentation>Web service task: melepas reservasi stok dan membatalkan pesanan.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:connector>
          <camunda:connectorId>http-connector</camunda:connectorId>
          <camunda:inputOutput>
            <camunda:inputParameter name="url">http://mock-api:8081/inventory/release</camunda:inputParameter>
            <camunda:inputParameter name="method">POST</camunda:inputParameter>
            <camunda:inputParameter name="headers">
              <camunda:map>
                <camunda:entry key="Content-Type">application/json</camunda:entry>
              </camunda:map>
            </camunda:inputParameter>
            <camunda:inputParameter name="payload">{"orderId":"${orderId}","reason":"${stockAvailable ? 'ditolak-manajer' : 'stok-habis'}"}</camunda:inputParameter>
            <camunda:outputParameter name="cancelResponse">${response}</camunda:outputParameter>
          </camunda:inputOutput>
        </camunda:connector>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_OutOfStock_Cancel</bpmn:incoming>
      <bpmn:incoming>Flow_Approval_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_Cancel_End</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Completed" name="Pengiriman terjadwal">
      <bpmn:incoming>Flow_Ship_Completed</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Cancelled" name="Pesanan dibatalkan">
      <bpmn:incoming>Flow_Cancel_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_ReminderSent" name="Pengingat terkirim">
      <bpmn:incoming>Flow_Reminder_End</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_Start_Reserve" sourceRef="StartEvent_OrderPlaced" targetRef="ServiceTask_ReserveStock" />
    <bpmn:sequenceFlow id="Flow_Reserve_Gateway" sourceRef="ServiceTask_ReserveStock" targetRef="Gateway_StockAvailable" />
    <bpmn:sequenceFlow id="Flow_InStock_Approval" name="Ya" sourceRef="Gateway_StockAvailable" targetRef="UserTask_ManagerApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${stockAvailable}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_OutOfStock_Cancel" name="Stok habis" sourceRef="Gateway_StockAvailable" targetRef="ServiceTask_CancelOrder" />
    <bpmn:sequenceFlow id="Flow_Approval_Decision" sourceRef="UserTask_ManagerApproval" targetRef="Gateway_OrderApproved" />
    <bpmn:sequenceFlow id="Flow_Approval_Charge" name="Ya" sourceRef="Gateway_OrderApproved" targetRef="ServiceTask_ChargePayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.hasVariable('approved') and approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Approval_Rejected" name="Ditolak" sourceRef="Gateway_OrderApproved" targetRef="ServiceTask_CancelOrder" />
    <bpmn:sequenceFlow id="Flow_Charge_Prepare" sourceRef="ServiceTask_ChargePayment" targetRef="Gateway_PrepareOrder" />
    <bpmn:sequenceFlow id="Flow_Prepare_Invoice" name="Invoice" sourceRef="Gateway_PrepareOrder" targetRef="ServiceTask_CreateInvoice" />
    <bpmn:sequenceFlow id="Flow_Prepare_Packing" name="Pengemasan" sourceRef="Gateway_PrepareOrder" targetRef="ManualTask_WarehousePacking" />
    <bpmn:sequenceFlow id="Flow_Packing_Confirmation" sourceRef="ManualTask_WarehousePacking" targetRef="UserTask_WarehouseConfirmation" />
    <bpmn:sequenceFlow id="Flow_Invoice_Ready" sourceRef="ServiceTask_CreateInvoice" targetRef="Gateway_OrderReady" />
    <bpmn:sequenceFlow id="Flow_Confirmation_Inspect" sourceRef="UserTask_WarehouseConfirmation" targetRef="ManualTask_InspectPackaging" />
    <bpmn:sequenceFlow id="Flow_Inspect_Record" sourceRef="ManualTask_InspectPackaging" targetRef="UserTask_QualityInspection" />
    <bpmn:sequenceFlow id="Flow_Inspection_Decision" sourceRef="UserTask_QualityInspection" targetRef="Gateway_QualityPassed" />
    <bpmn:sequenceFlow id="Flow_Quality_Ready" name="Lolos" sourceRef="Gateway_QualityPassed" targetRef="Gateway_OrderReady">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.hasVariable('qualityPassed') and qualityPassed == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Quality_Rework" name="Perlu perbaikan" sourceRef="Gateway_QualityPassed" targetRef="ManualTask_WarehousePacking" />
    <bpmn:sequenceFlow id="Flow_Ready_Ship" sourceRef="Gateway_OrderReady" targetRef="ServiceTask_ShipOrder" />
    <bpmn:sequenceFlow id="Flow_Ship_Completed" sourceRef="ServiceTask_ShipOrder" targetRef="EndEvent_Completed" />
    <bpmn:sequenceFlow id="Flow_Cancel_End" sourceRef="ServiceTask_CancelOrder" targetRef="EndEvent_Cancelled" />
    <bpmn:sequenceFlow id="Flow_Timeout_Reminder" sourceRef="BoundaryEvent_ApprovalTimeout" targetRef="ServiceTask_SendReminder" />
    <bpmn:sequenceFlow id="Flow_Reminder_End" sourceRef="ServiceTask_SendReminder" targetRef="EndEvent_ReminderSent" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Ecommerce">
    <bpmndi:BPMNPlane id="BPMNPlane_Ecommerce" bpmnElement="Collaboration_Ecommerce">
      <bpmndi:BPMNShape id="Participant_Ecommerce_di" bpmnElement="Participant_Ecommerce" isHorizontal="true">
        <dc:Bounds x="90" y="40" width="2270" height="1120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="120" y="40" width="2240" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Manager_di" bpmnElement="Lane_Manager" isHorizontal="true">
        <dc:Bounds x="120" y="420" width="2240" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Warehouse_di" bpmnElement="Lane_Warehouse" isHorizontal="true">
        <dc:Bounds x="120" y="620" width="2240" height="210" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_QualityControl_di" bpmnElement="Lane_QualityControl" isHorizontal="true">
        <dc:Bounds x="120" y="830" width="2240" height="330" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_OrderPlaced_di" bpmnElement="StartEvent_OrderPlaced">
        <dc:Bounds x="192" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="168" y="225" width="85" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_ReserveStock_di" bpmnElement="ServiceTask_ReserveStock">
        <dc:Bounds x="280" y="160" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_StockAvailable_di" bpmnElement="Gateway_StockAvailable" isMarkerVisible="true">
        <dc:Bounds x="440" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="430" y="145" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_ChargePayment_di" bpmnElement="ServiceTask_ChargePayment">
        <dc:Bounds x="840" y="160" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PrepareOrder_di" bpmnElement="Gateway_PrepareOrder">
        <dc:Bounds x="1010" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_CreateInvoice_di" bpmnElement="ServiceTask_CreateInvoice">
        <dc:Bounds x="1130" y="90" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_OrderReady_di" bpmnElement="Gateway_OrderReady">
        <dc:Bounds x="1880" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_ShipOrder_di" bpmnElement="ServiceTask_ShipOrder">
        <dc:Bounds x="2000" y="160" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Completed_di" bpmnElement="EndEvent_Completed">
